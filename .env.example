# Run node scripts/init-env.mjs to generate a secret. Never commit .env.
ADMIN_TOKEN=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
POLL_INTERVAL_SECONDS=30
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Optional canonical origin behind HTTPS reverse proxy, without trailing slash.
PUBLIC_ORIGIN=
# Docker Compose host binding (container PORT remains 3000).
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
# Optional domain used by the one-command installer and compose.https.yaml.
OIL_DOMAIN=
# Optional stable Compose project name; blank uses the deployment directory name.
COMPOSE_PROJECT_NAME=
